type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String
}

type Query {
    transactions: [Transaction]
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    createTransaction(
        accountId: ID!,
        amount: Float!,
        currency: String!,
        merchantCategory: String,
        country: String
    ): Transaction

    transfer(
        sourceId: ID!,
        destinationId: ID!,
        amount: Float!
    ): Transaction
}